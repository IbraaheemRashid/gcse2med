# ---------------------------------------------------------------------------
# GCSE2MED environment
#
# Every value here is OPTIONAL. With none of them set the site still builds and
# runs: emails are logged instead of sent, leads are not persisted, spam
# protection is skipped, and the booking modal falls back to the contact form.
# That is deliberate, so local development and the first deploy work before the
# accounts exist. All of them are required in production.
# ---------------------------------------------------------------------------

# Canonical origin, used for metadata, sitemap and email links.
NEXT_PUBLIC_SITE_URL=https://gcse2med.co.uk

# Cal.com or Calendly event URL, embedded in /book and the booking modal.
# e.g. https://cal.com/gcse2med/consultation  or  https://calendly.com/gcse2med/15min
NEXT_PUBLIC_BOOKING_URL=

# Resend — https://resend.com. EMAIL_FROM must be on a domain verified there.
RESEND_API_KEY=
EMAIL_FROM="GCSE2MED <hello@gcse2med.co.uk>"
EMAIL_INTERNAL_TO=hello@gcse2med.co.uk

# Supabase — leads and assessment_attempts. Service role key: server-side only,
# never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile — https://dash.cloudflare.com > Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
